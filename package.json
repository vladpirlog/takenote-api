{
    "name": "takenote-api",
    "author": "Vlad Pirlog",
    "description": "The REST API of a note-taking application.",
    "keywords": [
        "node",
        "express",
        "mongodb",
        "typescript",
        "jest"
    ],
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "prebuild": "rimraf dist",
        "build": "tsc -p .",
        "lint": "eslint src/**/*.ts test/**/*.ts --fix",
        "start": "node ./dist/bin/www.js",
        "stop": "rimraf dist",
        "start:dev": "tsc -w -p . & nodemon ./dist/bin/www.js",
        "test": "jest",
        "test:watch": "jest --watch"
    },
