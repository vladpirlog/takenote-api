        "dotenv": "^8.6.0",
        "express": "^5.2.1",
        "express-session": "^1.19.0",
        "ffmpeg": "0.0.4",
        "helmet": "^3.23.3",
        "hpp": "^0.2.3",
        "http-errors": "^1.8.1",
        "joi": "^18.2.3",
        "moesif-nodejs": "^3.11.0",
        "mongoose": "^9.9.2",
